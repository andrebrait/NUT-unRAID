<?
require_once '/usr/local/emhttp/plugins/nut3/include/nut_config.php';
require_once '/usr/local/emhttp/plugins/nut3/include/nut_managed.php';

$nut_mc = nut_mc_settings(nut_mc_read_cfg(NUT_MC_DIR . '/nut3.cfg'));
$nut_mc_errors = nut_mc_validate($nut_mc);
$nut_mc_pending = nut_mc_pending();
$nut_mc_text = function ($key) use ($nut_mc) { return htmlspecialchars(nut_mc_custom($nut_mc, $key)); };
$nut_mc_field = function ($key, $title, $help, $example) use ($nut_mc, $nut_mc_text) {
    return "<dl><dt><label for='{$key}_TEXT'>Custom $title Directives:</label></dt><dd>"
        . "<textarea id='{$key}_TEXT' class='nut-run nut-custom' data-field='$key' rows='3' spellcheck='false' placeholder='" . htmlspecialchars($example, ENT_QUOTES) . "'>" . $nut_mc_text($key) . "</textarea>"
        . "<input type='hidden' class='nut-run' id='$key' name='$key' value='" . htmlspecialchars($nut_mc[$key] ?? '', ENT_QUOTES) . "'>"
        . "</dd></dl><blockquote class='inline_help'><p>$help</p>"
        . "<p>These lines are added after the directives generated from the settings above. Unless noted above, directives the settings already generate cannot be overridden here, such conflicts are reported when applying.</p></blockquote>";
};

$showStatPrefs = version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.12.3', '>');
$lastStartFailed = false;
$nut_poll_ms = ($nut_refresh == "enable") ? max(abs(isset($display['refresh']) ? $display['refresh'] : 0), ($nut_interval * 1000)) : 0; // 0 = no auto refresh

if (file_exists('/usr/local/emhttp/plugins/nut3/misc/start-failed')) {
    if (!$nut_running) { $lastStartFailed = true; }
    unlink('/usr/local/emhttp/plugins/nut3/misc/start-failed');
}
