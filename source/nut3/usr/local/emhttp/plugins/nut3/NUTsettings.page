<script src="<?=autov('/plugins/nut3/js/jquery.mask.min.js');?>"></script>

<script type="text/javascript">
function checkNUTsettings() {
    var mode = $('#MODE').val();
    var Shutdown = $('#SHUTDOWN')[0].selectedIndex;
    for (var i = 0; i < 3; i++) {
        $('#SHUTDOWN'+i).toggle(i == Shutdown);
    }

    $('#SLAVE').toggle(mode === 'netserver');
    $('#DRIVERS').toggle(mode !== 'slave');
    $('#CUSTOMSERVER').toggle(mode !== 'slave');
    $('#UPSKILL').toggle(mode !== 'slave');
    $('#TESTCONN').toggle(mode === 'slave');
    $('#SERIAL').prop('type', $('#DRIVER').val() == 'custom' ? 'text' : 'hidden');
    $('#snmp').toggle($('#DRIVER').val() == 'snmp-ups');

    if (mode !== 'slave') {
        $('#IPADDR').val('127.0.0.1');
    }
    $('#IPADDR').attr('readonly', mode !== 'slave');
}

function checkNUTSTATsettings(toggleChanged = true) {
    $('#STATS-OR').hide();
    $('#STATS-OR-PREF').hide();
    if (toggleChanged) {
        $('#command2').val('/usr/local/emhttp/plugins/nut3/scripts/clear_stats');
    }
    if ($('#STATISTICS').val() === 'enable') {
        $('#STATS-OR').show();
        if ($('#STATISTICS').val() === 'enable' && $('#STATSOVERRIDE').val() === 'enable') {
            $('#STATS-OR-PREF').show();
        } else {
            $('#STATS-OR-PREF').hide();
        }
    } else {
        $('#STATS-OR').hide();
        $('#STATS-OR-PREF').hide();
    }
}

function checkRUNNING() {
    if ($('#SERVICE').val() === 'enable')
        $('#command').val('/usr/local/emhttp/plugins/nut3/scripts/start');
    else
        $('#command').val('/usr/local/emhttp/plugins/nut3/scripts/stop');

    if ("<?=$nut_running;?>" == 1){
        $('.nut-run').prop('disabled', true);
        $('#RESTART').prop('disabled', false);
    }else{
        $('.nut-run').prop('disabled', false);
        $('#RESTART').prop('disabled', true);
    }

    checkNUTsettings();
}

function checkBATTTEST() {
    var v = $('#BATTTEST').val();
    $('#BATTTEST-SETTINGS').toggle(v !== 'disable');
    $('#BATTTESTWDAY').toggle(v === 'weekly');
    $('#BATTTESTMDAY').toggle(v === 'monthly');
}

function checkPOWER() {
    if ($('#POWER')[0].selectedIndex < 1)
        $('#POWER-SETTINGS').hide();
    else
        $('#POWER-SETTINGS').show();
}

// passwords and custom directives are stored base64-encoded in the settings file
function nutB64(text) {
    return btoa(unescape(encodeURIComponent(text)));
}

function nutUnB64(text) {
    try { return decodeURIComponent(escape(atob(text))); } catch (e) { return ''; }
}

function decData() {
    ['MONPASS', 'SLAVEPASS', 'ADMINPASS'].forEach(function (id) {
        $('#' + id).val(nutUnB64($('#' + id).val()));
        $('#' + id.toLowerCase() + '-htext').toggle(/[\s#"\\=]/.test($('#' + id).val()));
    });
}

function encData() {
    ['MONPASS', 'SLAVEPASS', 'ADMINPASS'].forEach(function (id) {
        $('#' + id).val(nutB64($('#' + id).val()));
    });
    $('.nut-custom').each(function () {
        $('#' + $(this).data('field')).val(nutB64($(this).val()));
    });
}

function applySettings(e) {
    e.preventDefault();
    if (!nutValidate($('#nut-settings'))) return;
    encData();
    $.post('/plugins/nut3/include/nut_validate.php', $('#nut-settings').serialize(), function (data) {
        if (data && data.errors && data.errors.length) {
            decData();
            swal({title: 'Settings not applied', type: 'error', html: true,
                  text: '<div style="text-align:left">' + data.errors.map(function (error) { return '- ' + $('<div>').text(error).html(); }).join('<br>') + '</div>'});
        } else {
            $('#nut-settings').submit();
        }
    }, 'json').fail(function () {
        decData();
        swal('Settings not applied', 'The settings could not be validated, please try again.', 'error');
    });
}

/* native constraint validation with inline messages; fields hidden by the current mode are skipped,
 * and a collapsed section holding an invalid field is opened. Returns true if the form is valid. */
function nutValidate($form) {
    var first = null;
    $form.find('.nut-field-err').remove();
    $form.find('.nut-invalid').removeClass('nut-invalid').removeAttr('aria-invalid aria-describedby');
    $form.find('input, select').each(function() {
        if (this.disabled || this.type === 'hidden' || this.checkValidity()) return;
        if ($(this).parentsUntil($form).filter(function() { return this.style.display === 'none'; }).length) return;
        var eid = 'err-' + (this.id || this.name);
        var msg = (this.validity.valueMissing || !this.dataset.err) ? this.validationMessage : this.dataset.err;
        $(this).addClass('nut-invalid').attr({'aria-invalid': 'true', 'aria-describedby': eid})
            .after($('<span class="nut-field-err" role="alert"></span>').attr('id', eid).text(msg));
        first = first || this;
    });
    if (first) {
        $(first).closest('details').prop('open', true);
        first.focus();
    }
    return !first;
}

function TestConnection() {
    var $b = $('#btnTestConn').prop('disabled', true);
    var $r = $('#nut_testconn_result').html('<i class="fa fa-spinner fa-spin"></i> Testing...');
    // POST: the webGui adds its CSRF token to every jQuery POST, a GET could be triggered by another site
    $.post('/plugins/nut3/include/nut_testconn.php', {host: $('#IPADDR').val(), name: $('#NAME').val()}, null, 'json')
        .done(function(d) { $r.html(d.html); }) // server-side escaped
        .fail(function() { $r.html('<span class="nut-fail">Test failed: no valid answer from the server.</span>'); })
        .always(function() { $b.prop('disabled', false); });
}

function RotateNUTLog() {
    $('#command').val('');
    openBox('/plugins/nut3/scripts/rotate_log', 'NUT Service Logs Reset', 600, 600, true);
}

function RotateNUTSpamLog() {
    $('#command').val('');
    openBox('/plugins/nut3/scripts/rotate_spam', 'NUT Spam Logs Reset', 600, 600, true);
}

function Restart() {
    $('#command').val('/usr/local/emhttp/plugins/nut3/scripts/restart');
}

function ResetConfig() {
    $('#command').val('');
    openBox('/plugins/nut3/scripts/resetconf', 'NUT Configuration Reset', 600, 600, true);
}

function ScanUPS() {
    $('#command').val('');
    openBox('/plugins/nut3/scripts/nutscan', 'NUT Auto Configuration', 600, 600, true);
}

function ScanDrivers() {
    openBox('/plugins/nut3/scripts/nutscan_soft', 'NUT Device Scanner', 600, 600, false);
}

function USBDiagnostics() {
    openBox('/plugins/nut3/scripts/usbdiagnostics', 'NUT USB Diagnostics', 600, 600, false);
}

function loadDevMessage() {
    $.get('/plugins/nut3/include/nut_devmsg.php', function (data) {
        if(data && data.text && data.md5) {
            $('#nutdevmsg0').text(data.text);
            $('#nutdevmsg0').attr("data-md5", data.md5);
            if ($.cookie('nutdevmsg')!==undefined) {
                var msgMD5 = data.md5;
                if($.cookie('nutdevmsg') !== msgMD5) {
                    $('#nutdevmsg').show();
                }
            } else {
                $('#nutdevmsg').show();
            }
            $('#hidenutdevmsg').click(hideDevMessage);
        }
    }, 'json');
}

function hideDevMessage() {
    var msgMD5 = $('#nutdevmsg0').attr("data-md5");
    $.cookie('nutdevmsg', msgMD5, { expires: 3650 });
    $('#nutdevmsg').hide();
}

<?if ($nut_running && $nut_mode == "netserver"):?>
function extractAndChainBrTags(inputString) {
    const brTags = inputString.match(/<br\s*\/?>/gi);
    if (!brTags) { return ''; }
    return brTags.join('');
}

function getNUTclients() {
  if (nutSkipIfHidden('getNUTclients', getNUTclients, <?=$nut_poll_ms?>)) return;
  $.get('/plugins/nut3/include/nut_clients.php', function(data) {
    if (data && data.success && data.success.response) {
        $('#nutclientsleft').html(extractAndChainBrTags(data.success.response));
        $('#nutclientsright').html(data.success.response);
    } else {
        $('#nutclientsright').html("<i class='fa fa-times-circle red-text'></i> <em>Error (check logs)</em>");
    }
  }, 'json');
  nutSchedule('getNUTclients', getNUTclients, <?=$nut_poll_ms?>);
}
