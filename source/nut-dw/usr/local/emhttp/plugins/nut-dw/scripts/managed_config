 * as published by the Free Software Foundation.
 *
 * The above copyright notice and this permission notice shall be
 * included in all copies or substantial portions of the Software.
 *
 * write: import a previous configuration or generate the NUT files on the flash drive (exit 1 if invalid)
 * scan:  apply the first device of nut-scanner output (read from stdin) to the settings
 */
require_once __DIR__ . '/../include/nut_managed.php';

switch ($argv[1] ?? '') {
    case 'write':
        $ok = nut_mc_deploy(NUT_MC_DIR, $messages);
        foreach ($messages as $message) {
            echo ($ok ? '' : 'ERROR: ') . $message . "\n";
        }
        exit($ok ? 0 : 1);
    case 'scan':
        [$cfg, $messages] = nut_mc_apply_scan(nut_mc_read_cfg(NUT_MC_DIR . '/nut-dw.cfg'), stream_get_contents(STDIN));
        if (!nut_mc_write_cfg(NUT_MC_DIR . '/nut-dw.cfg', $cfg)) {
            echo "ERROR: writing the NUT settings failed.\n";
            exit(1);
        }
        echo implode("\n", $messages) . "\n";
        exit(0);
    default:
        fwrite(STDERR, "usage: managed_config write|scan\n");
        exit(2);
}
